{
  "Platform": {
    "BrokerEnabled": false,
    "BrokerHost": "127.0.0.1",
    "BrokerPort": 5673,
    "BrokerVirtualHost": "dispute-development",
    "Prefetch": 16,
    "MaximumAttempts": 8,
    "RetryMilliseconds": 5000,
    "MaximumEventBytes": 262144,
    "HttpEventTimeoutSeconds": 30,
    "HttpEventConcurrency": 4,
    "OutboxPollMilliseconds": 500,
    "RecoveryDelayMilliseconds": 2000,
    "BrokerRecoverySeconds": 5,
    "BrokerHeartbeatSeconds": 20,
    "MigrationCommandTimeoutSeconds": 120,
    "MigrationLockTimeoutSeconds": 60,
    "ServiceTokenLifetimeSeconds": 60,
    "ServiceTokenClockSkewSeconds": 5,
    "ServiceTokenBackdateSeconds": 2,
    "MaximumRetryDelaySeconds": 300,
    "BrokerConnectionPollMilliseconds": 1000,
    "MaintenancePollMilliseconds": 1000,
    "OutboxLeaseSeconds": 60,
    "CleanupTimeoutSeconds": 10,
    "HstsMaxAgeDays": 365,
    "EventRoutes": {
      "identity": [
        "account.activated",
        "account.balance.updated",
        "transaction.completed",
        "transaction.failed",
        "notification.sent",
        "transaction.received",
        "configuration.updated",
        "reversal.review.completed",
        "assessment.account.requested"
      ],
      "accounts": [
        "user.registered",
        "ledger.account.created",
        "ledger.transaction.posted",
        "ledger.reservation.updated",
        "configuration.updated"
      ],
      "configuration": [
        "account.activated",
        "payment.completed",
        "payment.failed",
        "transaction.completed",
        "transaction.failed",
        "country.operation.settled",
        "ledger.import.settled",
        "debt.reviewed"
      ],
      "ledger": [
        "account.created"
      ],
      "payments": [
        "transaction.completed",
        "transaction.failed"
      ],
      "transactions": [
        "ledger.transaction.posted",
        "payment.initiated",
        "payment.authorized",
        "dispute.financial.requested"
      ],
      "notifications": [
        "transaction.completed",
        "transaction.failed",
        "account.activated",
        "transaction.received"
      ],
      "scheduling": [
        "transaction.completed",
        "transaction.failed",
        "debt.reviewed"
      ],
      "debt": [
        "reversal.preparation.requested"
      ],
      "reporting": [
        "ledger.transaction.posted",
        "payment.completed",
        "payment.failed"
      ],
      "audit": [
        "#"
      ]
    },
    "BrokerPublishTimeoutSeconds": 30,
    "OperatorHttpTimeoutSeconds": 120
  },
  "OpenTelemetry": {
    "ExportEnabled": false
  },
  "ServiceHttpResilience": {
    "TotalRequestTimeout": {
      "Timeout": "00:00:30"
    },
    "AttemptTimeout": {
      "Timeout": "00:00:10"
    },
    "Retry": {
      "MaxRetryAttempts": 2,
      "Delay": "00:00:00.200",
      "BackoffType": "Exponential",
      "UseJitter": true
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:30"
    },
    "RateLimiter": {
      "DefaultRateLimiterOptions": {
        "PermitLimit": 100,
        "QueueLimit": 0
      }
    }
  },
  "HttpsRedirection": {
    "HttpsPort": 8080
  },
  "PortalLogging": {
    "Directory": "Logs/Application",
    "FileSizeBytes": 10485760,
    "RetainedFiles": 40,
    "RetentionDays": 14,
    "QueueCapacity": 2048,
    "ConsoleEnabled": true,
    "ShutdownTimeoutSeconds": 5
  },
  "ServiceHttpTransport": {
    "PooledConnectionLifetime": "00:02:00",
    "PooledConnectionIdleTimeout": "00:01:00",
    "ConnectTimeout": "00:00:05",
    "MaxConnectionsPerServer": 100
  }
}
