<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Unix apphost "Configuration" collides with the shared configuration asset directory. -->
    <UseAppHost Condition="'$(OS)' != 'Windows_NT'">false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Infrastructure/Infrastructure.csproj" />
    <Content Update="seed-settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>