{
  "name": "transactions-dispute-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build --configLoader runner",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "playwright test frontend-authority.spec.ts support-pagination.spec.ts evidence-preview.spec.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "format": "prettier --write src e2e config scripts *.mjs *.js *.json",
    "format:check": "prettier --check src e2e config scripts *.mjs *.js *.json",
    "test:ui": "playwright test screens-and-dialogs.spec.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.64.0",
    "@microsoft/signalr": "10.0.11",
    "@vvo/tzdb": "^6.202.0",
    "country-flag-icons": "^1.6.20",
    "libphonenumber-js": "^1.13.15",
    "pdfjs-dist": "6.4.299",
    "pinia": "2.3.1",
    "vue": "3.5.44",
    "vue-router": "4.5.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.0.13",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "15.14.0",
    "prettier": "^3.9.10",
    "typescript": "5.7.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
}
