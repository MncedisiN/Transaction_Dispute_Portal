{
  "ConnectionStrings": {
    "SqlServer": "",
    "PostgreSql": ""
  },
  "Database": {
    "Provider": "PostgreSql",
    "AutoCreateSqlServerDatabase": false,
    "MigrationOnly": false,
    "SslMode": "VerifyFull",
    "TrustServerCertificate": false
  },
  "Authentication": {
    "Mode": "Cookie",
    "Authority": "",
    "Audience": "",
    "RequireStaffMfa": true,
    "Session": {
      "IdleMinutes": 15,
      "AbsoluteMinutes": 30
    },
    "LoginOtpEnabled": true,
    "RememberedDevices": {
      "Enabled": true,
      "Days": 30,
      "MaximumDevices": 5
    }
  },
  "OpenTelemetry": {
    "ServiceName": "transactions-dispute-portal-api",
    "OtlpEndpoint": "",
    "ExportEnabled": false
  },
  "AllowedOrigins": [],
  "DevelopmentSeed": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Operations": {
    "ServiceTargets": {
      "CriticalResponseHours": 1,
      "CriticalResolutionHours": 24,
      "HighResponseHours": 4,
      "HighResolutionHours": 48,
      "StandardResponseHours": 8,
      "StandardResolutionHours": 72,
      "LowResponseHours": 24,
      "LowResolutionHours": 168,
      "HighValueThreshold": 5000
    }
  },
  "Monitoring": {
    "FlushSeconds": 15,
    "MaximumSeries": 4096,
    "BatchSize": 256,
    "RetentionDays": 30,
    "StorageTimeoutSeconds": 5,
    "DefaultLookbackHours": 24
  },
  "PortalLogging": {
    "Directory": "Logs/Application",
    "FileSizeBytes": 10485760,
    "RetainedFiles": 40,
    "RetentionDays": 14,
    "QueueCapacity": 2048,
    "ConsoleEnabled": false,
    "ShutdownTimeoutSeconds": 5
  },
  "ApiRuntime": {
    "AssignmentIntervalSeconds": 20,
    "NotificationIntervalSeconds": 20,
    "AutomaticRefundIntervalSeconds": 15,
    "AutomaticRefundBatchSize": 5,
    "PushTimeoutSeconds": 15,
    "PushConnectTimeoutSeconds": 5,
    "MessagingTimeoutSeconds": 20,
    "PasswordCheckTimeoutSeconds": 6,
    "RealtimeHandshakeSeconds": 10,
    "RealtimeKeepAliveSeconds": 15,
    "RealtimeClientTimeoutSeconds": 30,
    "RealtimeConnectionLimit": 4,
    "RateLimits": {
      "security": {
        "PermitLimit": 5,
        "WindowSeconds": 60
      },
      "auth": {
        "PermitLimit": 8,
        "WindowSeconds": 60
      },
      "sensitive": {
        "PermitLimit": 30,
        "WindowSeconds": 60
      },
      "operations-read": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      }
    },
    "PasswordCheckEndpoint": "https://api.pwnedpasswords.com/range/",
    "BusinessTimeZone": "Africa/Johannesburg",
    "RealtimeSessionCheckSeconds": 30,
    "RealtimeSessionEndTimeoutSeconds": 1,
    "RealtimePublishTimeoutSeconds": 3,
    "RealtimeMutationTimeoutSeconds": 4,
    "RealtimeTransportSendSeconds": 5,
    "RealtimeCloseSeconds": 3,
    "FinancialReconciliationTimeoutSeconds": 10,
    "TokenClockSkewSeconds": 60,
    "PushPoolLifetimeSeconds": 300,
    "MigrationCommandTimeoutSeconds": 120,
    "VerificationCodeLifetimeMinutes": 5,
    "VerificationResendDelaySeconds": 60,
    "LoginFlowLifetimeMinutes": 15,
    "NotificationLeaseMinutes": 10,
    "RealtimeDatabaseTimeoutSeconds": 3,
    "EvidencePayloadWriteTimeoutSeconds": 90
  },
  "Redis": {
    "Enabled": false,
    "OperationTimeoutMilliseconds": 750,
    "ReferenceTtlSeconds": 300,
    "MaximumValueBytes": 262144,
    "MaximumConcurrentSourceReads": 8,
    "SourceWaitMilliseconds": 250,
    "FillLeaseMilliseconds": 3000,
    "ClientName": "dispute-portal-reference-cache",
    "ReconnectInitialDelayMilliseconds": 1000,
    "ReconnectMaximumDelayMilliseconds": 5000,
    "DisposalTimeoutMilliseconds": 3000,
    "FillWaitAttempts": 3,
    "FillWaitMilliseconds": 50,
    "TtlJitterMinimumPercent": 90,
    "TtlJitterMaximumPercent": 100
  },
  "PasswordSecurity": {
    "CheckBreaches": true
  },
  "Platform": {
    "BrokerEnabled": false
  },
  "Infobip": {
    "WhatsAppTemplateLanguage": "en"
  },
  "Hsts": {
    "MaxAge": "365.00:00:00",
    "IncludeSubDomains": false
  }
}
